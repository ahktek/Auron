# --- LiteSpeed Passenger Next.js Standalone Configuration ---
PassengerAppRoot /home/u505959191/domains/curecarebd.com/public_html
PassengerBaseURI /
PassengerNodejs /opt/alt/alt-nodejs22/root/bin/node
PassengerAppType node
PassengerStartupFile server.js
PassengerAppEnv production

# Direct Delivery for Static Assets
RewriteEngine On

# Direct mapping for Next.js static chunks
RewriteRule ^_next/static/(.*)$ .next/static/$1 [L]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

<IfModule mod_headers.c>
  # Prevent CDN / browser from caching HTML with outdated JS chunk hashes
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
  # Long cache for immutable static chunks
  <FilesMatch "\.(js|css|woff2|woff|ttf|png|jpg|jpeg|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
