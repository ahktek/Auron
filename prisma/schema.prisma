datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

enum Role {
  CUSTOMER
  OWNER
  EDITOR
  SUPPORT
}

enum OrderStatus {
  PENDING
  PAYMENT_FAILED
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIAL
  FULFILLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  passwordHash       String
  role               Role      @default(CUSTOMER)
  phone              String?
  isEmailVerified    Boolean   @default(false)
  emailVerifiedAt    DateTime?
  twoFactorSecret    String?
  twoFactorEnabled   Boolean   @default(false)
  resetPasswordToken String?
  resetPasswordExp   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  auditLogs     AdminAuditLog[]

  @@index([role])
}

model Address {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label             String?  @default("Home")
  firstName         String
  lastName          String
  company           String?
  street1           String
  street2           String?
  city              String
  state             String
  postalCode        String
  country           String   @default("United States")
  countryCode       String   @default("US")
  phone             String?
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  bannerImage String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  sortOrder   Int        @default(0)
  isFeatured  Boolean    @default(false)
  metaTitle   String?
  metaDesc    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products Product[]

  @@index([parentId])
  @@index([sortOrder])
}

model Collection {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  title            String
  subtitle         String?
  description      String?
  editorialHeader  String?
  heroImage        String?
  isFeatured       Boolean  @default(false)
  sortOrder        Int      @default(0)
  isRuleBased      Boolean  @default(false)
  rules            Json?
  metaTitle        String?
  metaDesc         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  productCollections ProductCollection[]

  @@index([sortOrder])
}

model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  subtitle        String?
  description     String
  details         String?  // Rich features summary
  careInfo        String?
  dimensionsInfo  String?
  materialsInfo   String?
  capacityInfo    String?
  basePrice       Decimal  @db.Decimal(10, 2)
  compareAtPrice  Decimal? @db.Decimal(10, 2)
  costPrice       Decimal? @db.Decimal(10, 2)
  currency        String   @default("USD")
  isPublished     Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  isBestseller    Boolean  @default(false)
  isNewRelease    Boolean  @default(false)
  isBundle        Boolean  @default(false)
  isComingSoon    Boolean  @default(false)
  sortOrder       Int      @default(0)
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  tags            String[] @default([])
  rating          Decimal  @default(5.0) @db.Decimal(3, 2)
  reviewCount     Int      @default(0)
  metaTitle       String?
  metaDesc        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variants           ProductVariant[]
  images             ProductImage[]
  collections        ProductCollection[]
  reviews            Review[]
  wishlistItems      WishlistItem[]
  comingSoonLeads    ComingSoonLead[]
  bundleParents      BundleItem[]       @relation("BundleParent")
  bundleChildren     BundleItem[]       @relation("BundleChild")

  @@index([categoryId])
  @@index([isPublished, isFeatured])
  @@index([isBestseller])
  @@index([isNewRelease])
}

model ProductCollection {
  productId    String
  collectionId String
  sortOrder    Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId])
  @@index([productId])
}

model ProductVariant {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                String   @unique
  title              String
  colorName          String?
  colorHex           String?
  materialName       String?
  sizeName           String?
  price              Decimal  @db.Decimal(10, 2)
  compareAtPrice     Decimal? @db.Decimal(10, 2)
  inventory          Int      @default(0)
  lowStockThreshold  Int      @default(5)
  weight             Decimal? @db.Decimal(8, 2)
  barcode            String?
  isDefault          Boolean  @default(false)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  images                ProductImage[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  inventoryReservations InventoryReservation[]

  @@index([productId])
  @@index([sku])
}

model ProductImage {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  url        String
  altText    String
  focalPoint String?         @default("center")
  width      Int             @default(1200)
  height     Int             @default(1200)
  sortOrder  Int             @default(0)
  isHero     Boolean         @default(false)
  createdAt  DateTime        @default(now())

  @@index([productId])
  @@index([variantId])
}

model BundleItem {
  id              String  @id @default(cuid())
  bundleProductId String
  bundleProduct   Product @relation("BundleParent", fields: [bundleProductId], references: [id], onDelete: Cascade)
  itemProductId   String
  itemProduct     Product @relation("BundleChild", fields: [itemProductId], references: [id], onDelete: Cascade)
  quantity        Int     @default(1)

  @@index([bundleProductId])
  @@index([itemProductId])
}

model Cart {
  id             String     @id @default(cuid())
  userId         String?
  guestSessionId String?    @unique
  currency       String     @default("USD")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  items CartItem[]

  @@index([userId])
  @@index([guestSessionId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
}

model Order {
  id                     String            @id @default(cuid())
  orderNumber            String            @unique
  userId                 String?
  user                   User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestEmail             String?
  guestName              String?
  status                 OrderStatus       @default(PENDING)
  paymentStatus          PaymentStatus     @default(UNPAID)
  fulfillmentStatus      FulfillmentStatus @default(UNFULFILLED)
  subtotal               Decimal           @db.Decimal(10, 2)
  discountTotal          Decimal           @default(0) @db.Decimal(10, 2)
  shippingTotal          Decimal           @default(0) @db.Decimal(10, 2)
  taxTotal               Decimal           @default(0) @db.Decimal(10, 2)
  total                  Decimal           @db.Decimal(10, 2)
  currency               String            @default("USD")
  stripeSessionId        String?           @unique
  stripePaymentIntentId  String?           @unique
  discountCodeId         String?
  discountCode           DiscountCode?     @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  shippingAddress        Json
  billingAddress         Json?
  shippingMethod         String?
  trackingNumber         String?
  trackingCarrier        String?
  packingSlipUrl         String?
  notes                  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  items OrderItem[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id           String         @id @default(cuid())
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  productName  String
  variantTitle String
  sku          String
  unitPrice    Decimal        @db.Decimal(10, 2)
  quantity     Int
  total        Decimal        @db.Decimal(10, 2)
  imageUrl     String?

  @@index([orderId])
  @@index([variantId])
}

model InventoryReservation {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderId   String?
  sessionId String
  quantity  Int
  expiresAt DateTime
  createdAt DateTime       @default(now())

  @@index([variantId])
  @@index([sessionId])
  @@index([expiresAt])
}

model Review {
  id                 String       @id @default(cuid())
  productId          String
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName         String
  authorEmail        String
  rating             Int          @default(5)
  title              String
  body               String
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([productId])
  @@index([status])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model DiscountCode {
  id          String       @id @default(cuid())
  code        String       @unique
  type        DiscountType @default(PERCENTAGE)
  value       Decimal      @db.Decimal(10, 2)
  minSubtotal Decimal?     @db.Decimal(10, 2)
  maxUses     Int?
  usedCount   Int          @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  orders Order[]

  @@index([code])
  @@index([isActive])
}

model CmsPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  metaTitle   String?
  metaDesc    String?
  isPublished Boolean  @default(true)
  template    String   @default("default")
  sections    Json     // Array of block sections (Hero, Rail, Editorial, etc.)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions CmsPageVersion[]

  @@index([slug])
  @@index([isPublished])
}

model CmsPageVersion {
  id        String   @id @default(cuid())
  pageId    String
  page      CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version   Int
  sections  Json
  title     String
  changedBy String?
  createdAt DateTime @default(now())

  @@index([pageId])
}

model JournalPost {
  id                 String    @id @default(cuid())
  slug               String    @unique
  title              String
  subtitle           String?
  excerpt            String
  content            String    // Sanitized rich HTML / Markdown
  coverImage         String
  authorName         String    @default("AUREN Editorial")
  authorAvatar       String?
  categoryName       String    @default("Design & Craft")
  tags               String[]  @default([])
  isPublished        Boolean   @default(true)
  publishedAt        DateTime? @default(now())
  readingTimeMinutes Int       @default(4)
  metaTitle          String?
  metaDesc           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished, publishedAt])
}

model MegaMenuItem {
  id            String   @id @default(cuid())
  label         String
  href          String
  group         String   // "featured", "bags-luggage", "travel", "wallets", "tech", "accessories", "about"
  column        String   // column designation within group (e.g. "popular", "by-activity", "by-collection")
  sortOrder     Int      @default(0)
  isHighlighted Boolean  @default(false)
  badge         String?
  icon          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([group, sortOrder])
}

model AnnouncementBar {
  id        String    @id @default(cuid())
  text      String
  linkUrl   String?
  linkText  String?
  isActive  Boolean   @default(true)
  bgHex     String    @default("#18181B")
  textHex   String    @default("#FFFFFF")
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Stockist {
  id          String   @id @default(cuid())
  name        String
  street      String
  city        String
  state       String
  postalCode  String
  country     String
  countryCode String   @default("US")
  phone       String?
  website     String?
  latitude    Float
  longitude   Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([countryCode])
  @@index([isActive])
}

model NewsletterSubscriber {
  id                String           @id @default(cuid())
  email             String           @unique
  status            SubscriberStatus @default(PENDING)
  confirmationToken String?
  source            String           @default("footer")
  consentGiven      Boolean          @default(true)
  consentedAt       DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([email])
}

model ComingSoonLead {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  email      String
  notifiedAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([productId, email])
  @@index([productId])
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  url          String
  altText      String
  focalPoint   String?  @default("center")
  width        Int      @default(1200)
  height       Int      @default(1200)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  adminUser   User?    @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      String   // CREATE, UPDATE, DELETE, PUBLISH, REFUND, FULFILL
  entityType  String   // Product, Order, CmsPage, Category, DiscountCode, etc.
  entityId    String
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([adminUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model RedirectRule {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301) // 301 or 302
  isActive   Boolean  @default(true)
  hitCount   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([fromPath])
}

model StoreSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
